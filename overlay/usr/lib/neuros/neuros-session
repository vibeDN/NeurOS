#!/bin/sh
# NeurOS compositor session - ExecStart of neuros-comp.service. systemd owns the
# lifecycle (single instance) and the tty1 seat.
set -e

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/0}"
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"

# a stale tmux server can linger across a service restart
tmux kill-server 2>/dev/null || true

# a UTF-8 locale is mandatory for foot/fcft
export LANG="${LANG:-C.UTF-8}"
export LC_ALL="${LC_ALL:-C.UTF-8}"

# software GL (llvmpipe) - the dev VM has no real 3D
export WLR_RENDERER="${WLR_RENDERER:-gles2}"
export LIBGL_ALWAYS_SOFTWARE=1
export GALLIUM_DRIVER="${GALLIUM_DRIVER:-llvmpipe}"

# libseat: builtin backend (we run as root); it embeds seatd in-process, which
# shows as a second short-lived neuros-comp - expected, not a duplicate compositor
export LIBSEAT_BACKEND="${LIBSEAT_BACKEND:-builtin}"

export TERM=foot

# M3: the agent orchestrator owns a tmux session ("agent"); the centre-pane
# terminal attaches to it. Start agentd first (it creates the session).
if [ -x /usr/lib/neuros/neuros-agentd ]; then
	/usr/lib/neuros/neuros-agentd &
	i=0
	while ! tmux has-session -t agent 2>/dev/null && [ $i -lt 100 ]; do
		sleep 0.1
		i=$((i + 1))
	done
fi

# -d: server-side decorations -> foot draws no titlebar in the centre pane
if tmux has-session -t agent 2>/dev/null; then
	exec neuros-comp -k -s -d "$@" -- foot tmux attach -t agent
else
	exec neuros-comp -k -s -d "$@" -- foot
fi
