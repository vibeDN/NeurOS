#!/bin/sh
# Start the NeurOS compositor on the seat. Invoked on tty1 (see
# /etc/profile.d/neuros-session.sh). Kept minimal for M2 bring-up; a proper
# systemd seat service replaces this later.
set -e

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/0}"
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"

# a UTF-8 locale is mandatory for foot/fcft
export LANG="${LANG:-C.UTF-8}"
export LC_ALL="${LC_ALL:-C.UTF-8}"

# software GL (llvmpipe) - the dev VM has no real 3D
export WLR_RENDERER="${WLR_RENDERER:-gles2}"
export LIBGL_ALWAYS_SOFTWARE=1
export GALLIUM_DRIVER="${GALLIUM_DRIVER:-llvmpipe}"

# libseat: seatd daemon if present, else the builtin (root on the VT) backend
if [ -S /run/seatd.sock ]; then
	export LIBSEAT_BACKEND="${LIBSEAT_BACKEND:-seatd}"
else
	export LIBSEAT_BACKEND="${LIBSEAT_BACKEND:-builtin}"
fi

# centre pane: a terminal for now (becomes the agent CLI host in M3)
export TERM=foot
# -d: server-side decorations -> foot draws no titlebar in the centre pane
exec neuros-comp -k -s -d "$@" -- foot
