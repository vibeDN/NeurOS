# NeurOS - x86_64 development target (VirtualBox / QEMU)
# Milestone 0: boots to an autologin root shell under systemd.

BR2_x86_64=y

# Toolchain: prebuilt Bootlin external (glibc, C++). Skips building
# binutils/gcc/glibc from source - much faster iteration. glibc is required
# for systemd, the wayland stack, node, and libhybris.
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_X86_64_GLIBC_STABLE=y

# Init: systemd (logind seats/sessions for the compositor, unit mgmt for agentd)
BR2_INIT_SYSTEMD=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y

# Locale: glibc 2.41 (Bootlin) ships C.UTF-8 built in - just point LANG at it
# (overlay/etc/locale.conf + neuros-session). Generating locales here would drag
# in host-localedef == a full glibc git clone, so we don't.

# System identity
BR2_TARGET_GENERIC_HOSTNAME="neuros"
BR2_TARGET_GENERIC_ISSUE="NeurOS \n \l"
BR2_TARGET_GENERIC_ROOT_PASSWD="neuros"
BR2_TARGET_GENERIC_GETTY_PORT="tty1"
BR2_SYSTEM_BIN_SH_BASH=y
BR2_TARGET_ENABLE_ROOT_LOGIN=y

# Rootfs overlay (branding, autologin drop-ins, networkd config)
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_NEUROS_PATH)/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_NEUROS_PATH)/board/neuros/x86_64/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_NEUROS_PATH)/board/neuros/x86_64/post-image.sh"

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_NEUROS_PATH)/board/neuros/x86_64/linux.config"
BR2_LINUX_KERNEL_INSTALL_TARGET=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# Filesystem image: ext4 rootfs, assembled into a BIOS-bootable disk.img
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="2G"
# BR2_TARGET_ROOTFS_TAR is not set

# Bootloader: GRUB2 i386-pc (BIOS)
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_I386_PC=y
BR2_TARGET_GRUB2_INSTALL_TOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y

# --- M1: graphics / Wayland stack ---
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_GBM=y
# llvmpipe: GLES2 in software so the VM matches the phone's GL pipeline
# (VirtualBox exposes no 3D -> without this wlroots uses the pixman renderer,
# which can't run our gradient shader). Pulls llvm (long first build, cached).
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_LLVMPIPE=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SOFTPIPE=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SVGA=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VIRGL=y
BR2_PACKAGE_WAYLAND=y
BR2_PACKAGE_WAYLAND_PROTOCOLS=y
BR2_PACKAGE_WLROOTS=y
BR2_PACKAGE_SEATD=y
BR2_PACKAGE_SEATD_DAEMON=y
BR2_PACKAGE_LIBINPUT=y
BR2_PACKAGE_LIBXKBCOMMON=y
BR2_PACKAGE_XKEYBOARD_CONFIG=y
BR2_PACKAGE_CAGE=y
BR2_PACKAGE_NEUROS_COMP=y
# terminal for the centre pane (also brings fcft/freetype/fontconfig, reused
# for the shell's small monospace text)
BR2_PACKAGE_FOOT=y
BR2_PACKAGE_FOOT_THEMES=y
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_DEJAVU_SANS_MONO=y

# Base userland for development / bring-up
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_SUDO=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_NEOFETCH=y
BR2_PACKAGE_GIT=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
