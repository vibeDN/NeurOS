#!/bin/sh
# Show the shared-memory endpoint + token, to paste into
# claude.ai -> Settings -> Connectors -> Add custom connector.
[ -r /etc/neuros/memory.conf ] && . /etc/neuros/memory.conf
echo "URL:   ${MEMORY_MCP_URL:-(MEMORY_MCP_URL unset in /etc/neuros/memory.conf)}"
echo "Token: $(cat /etc/neuros/mcp-token 2>/dev/null || echo '(write /etc/neuros/mcp-token)')"
echo
echo "Browse: ${MEMORY_MCP_URL%/mcp}/?k=$(cat /etc/neuros/mcp-token 2>/dev/null)"
