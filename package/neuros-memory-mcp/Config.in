config BR2_PACKAGE_NEUROS_MEMORY_MCP
	bool "neuros-memory-mcp (shared agent memory cache)"
	depends on BR2_PACKAGE_HOST_GO_TARGET_ARCH_SUPPORTS
	depends on BR2_PACKAGE_HOST_GO_TARGET_CGO_LINKING_SUPPORTS
	help
	  On-device MCP server for the shared agent memory. Serves the
	  memory_list / memory_read / memory_search / memory_write /
	  memory_delete tools to Claude Code, backed by a local cache in
	  front of the canonical neuros-memory Cloudflare Worker
	  (MEMORY_MCP_URL in /etc/neuros/memory.conf) - reads pass through
	  and are mirrored, writes hit the cache and are pushed (queued
	  while offline). Claude on claude.ai talks to the Worker directly.

comment "neuros-memory-mcp needs a Go-capable toolchain"
	depends on !BR2_PACKAGE_HOST_GO_TARGET_ARCH_SUPPORTS || \
		!BR2_PACKAGE_HOST_GO_TARGET_CGO_LINKING_SUPPORTS
