// NeurOS fastfetch config. The logo + its colour are supplied per-agent by
// /usr/lib/neuros/neurofetch (icon depends on which AI is loaded).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "key": { "width": 9 }
  },
  "modules": [
    { "type": "title", "format": "{user-name} @ {host-name}" },
    "separator",
    { "type": "os", "key": "os", "format": "NeurOS" },
    { "type": "kernel", "key": "kernel" },
    { "type": "uptime", "key": "uptime" },
    { "type": "shell", "key": "shell" },
    { "type": "terminal", "key": "term" },
    { "type": "cpu", "key": "cpu", "showPeCoreCount": false },
    { "type": "memory", "key": "mem" },
    { "type": "command", "key": "agent", "text": ". /etc/neuros/agentd.conf 2>/dev/null; printf '%s (%s)' \"${AGENT_NAME:-none}\" \"${AGENT_MODEL:-}\"" },
    "break",
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
  ]
}
