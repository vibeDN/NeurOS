#!/bin/sh
# Push the top-strip line (time / date / battery) to the compositor every ~20s.
set -u

SOCK="${XDG_RUNTIME_DIR:-/run/user/0}/neuros-comp.sock"
i=0
while [ ! -S "$SOCK" ] && [ $i -lt 150 ]; do
	sleep 0.2
	i=$((i + 1))
done

battery() {
	for d in /sys/class/power_supply/*/capacity; do
		[ -r "$d" ] || continue
		cap=$(cat "$d" 2>/dev/null) || continue
		s=$(cat "$(dirname "$d")/status" 2>/dev/null)
		[ "$s" = "Charging" ] && cap="${cap}+"
		printf '     BAT %s%%' "$cap"
		return
	done
}

while :; do
	neuros-ctl strip "$(date '+%H:%M     %a %d %b')$(battery)" 2>/dev/null || true
	sleep 20
done
