#!/bin/sh
# Push the top-strip lines to the compositor every ~20s:
#   strip        left  - HH:MM  + date
#   strip_right  right - battery
set -u

SOCK="${XDG_RUNTIME_DIR:-/run/user/0}/neuros-comp.sock"
i=0
while [ ! -S "$SOCK" ] && [ $i -lt 150 ]; do
	sleep 0.2
	i=$((i + 1))
done

battery() {
	for d in /sys/class/power_supply/*/capacity; do
		[ -r "$d" ] || continue
		cap=$(cat "$d" 2>/dev/null) || continue
		s=$(cat "$(dirname "$d")/status" 2>/dev/null)
		[ "$s" = "Charging" ] && cap="${cap}+"
		echo "BAT ${cap}%"
		return
	done
}

while :; do
	neuros-ctl strip "$(date '+%H:%M     %a %d %b')" 2>/dev/null || true
	bat=$(battery)
	[ -n "$bat" ] && neuros-ctl strip_right "$bat" 2>/dev/null || true
	sleep 20
done
