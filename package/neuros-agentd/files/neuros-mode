#!/bin/sh
# Switch the agent between "code" (Claude Code, full tools) and "chat"
# (conversational, no tools). Swaps the command running in the "agent" tmux
# pane in place - the session, the output pipe and neuros-agentd all keep
# running. Runs as root (called from the compositor's key handler / IPC).
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/0}"

CONF=/etc/neuros/agentd.conf
[ -r "$CONF" ] && . "$CONF"
: "${TMUX_SESSION:=agent}"
: "${AGENT_USER:=claude}"
: "${AGENT_WORKDIR:=/home/claude}"
: "${CODE_CMD:=claude}"
: "${CHAT_CMD:=neuros-chat}"
: "${CODE_MODEL:=Sonnet 5}"
: "${CHAT_MODEL:=chat}"

F=/run/neuros/mode
mkdir -p /run/neuros
cur=$(cat "$F" 2>/dev/null)
: "${cur:=${AGENT_MODE:-code}}"

case "${1:-toggle}" in
chat) new=chat ;;
code) new=code ;;
toggle) [ "$cur" = chat ] && new=code || new=chat ;;
*) echo "usage: neuros-mode chat|code|toggle" >&2; exit 2 ;;
esac

[ "$new" = "$cur" ] && exit 0
printf '%s\n' "$new" > "$F"

case "$new" in
chat) cmd=$CHAT_CMD; model=$CHAT_MODEL ;;
code) cmd=$CODE_CMD; model=$CODE_MODEL ;;
esac

inner="export COLORTERM=truecolor; cd $AGENT_WORKDIR && exec $cmd"
if [ -n "$AGENT_USER" ] && [ "$(id -u)" = 0 ] && id "$AGENT_USER" >/dev/null 2>&1; then
	launch="su -s /bin/sh $AGENT_USER -c '$inner'"
else
	launch="$inner"
fi

tmux respawn-pane -k -t "$TMUX_SESSION" "$launch" 2>/dev/null || {
	echo "neuros-mode: no agent session" >&2
	exit 1
}
neuros-ctl model "$model" 2>/dev/null || true
neuros-ctl status Idle 2>/dev/null || true
command -v neuros-ctl >/dev/null 2>&1 && neuros-ctl activity "" 2>/dev/null || true
echo "mode: $new"
