#!/bin/sh
# NeurOS "chat" mode: the same Claude Code binary (same OAuth login, same TTS
# Stop hook) with a conversational persona and no tools, isolated from the
# coding agent:
#   --setting-sources ""  -> no ~/.claude/CLAUDE.md, no auto-memory, no CLAUDE.md
#                            discovery, no settings-defined hooks
#   --system-prompt-file  -> replaces the whole system prompt with the chat persona
#   --tools ""            -> no shell / file / web access
#
# CHAT_SYNC (from agentd.conf):
#   local  (default) - a chat-only session id kept in /run: instant, no sync,
#                      fresh per boot, never mixes with the code sessions
#   cloud            - `claude --cloud`: the session runs on Anthropic's cloud
#                      and shows up at claude.ai/code and in Claude Desktop, so
#                      it continues across devices. Costs cloud quota + latency.
set -u

CONF=/etc/neuros/agentd.conf
[ -r "$CONF" ] && . "$CONF"
: "${CHAT_SYNC:=local}"

set -- \
	--system-prompt-file /usr/share/neuros/chat-prompt.txt \
	--tools "" \
	--setting-sources "" \
	--permission-mode dontAsk \
	"$@"

if [ "$CHAT_SYNC" = cloud ]; then
	CIDF=/run/neuros/chat-cloud-url
	if [ -s "$CIDF" ]; then
		set -- --cloud "$(cat "$CIDF")" "$@"
	else
		set -- --cloud "NeurOS chat" "$@"
		# claude prints the session URL; the agentd wrapper could capture it.
		# Best effort: leave a marker so a later launch resumes.
		: > "$CIDF"
	fi
else
	SIDF=/run/neuros/chat-sid
	mkdir -p /run/neuros 2>/dev/null || true
	[ -s "$SIDF" ] || cat /proc/sys/kernel/random/uuid > "$SIDF" 2>/dev/null
	SID=$(cat "$SIDF" 2>/dev/null)
	if [ -n "$SID" ] && [ -e "$SIDF.open" ]; then
		set -- --resume "$SID" "$@"
	elif [ -n "$SID" ]; then
		: > "$SIDF.open"
		set -- --session-id "$SID" "$@"
	fi
fi

exec claude "$@"
