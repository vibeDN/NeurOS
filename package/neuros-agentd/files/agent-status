#!/bin/sh
# Classify the agent's *visible pane* (whole block on stdin) -> a status word.
# Tuned for Claude Code v2's TUI (spinner line carries "esc to interrupt";
# a finished turn shows "... · done H:MMam"). Falls back to Idle.
t=$(cat)

case "$t" in
# permission / choice prompt waiting on the user
*"Do you want"*|*"❯ 1. Yes"*|*"1. Yes"*|*"Continue?"*|*"(y/n)"*)
	echo Waiting; exit 0 ;;
esac

case "$t" in
*"esc to interrupt"*|*"ctrl+c to"*|*"(esc)"*" to interrupt"*)
	case "$t" in
	*"Thinking"*|*"Pondering"*|*"Reflecting"*|*"Deliberating"*|*"Puzzling"*|*"Ruminating"*)
		echo Thinking ;;
	*)	echo Working ;;
	esac
	exit 0 ;;
esac

echo Idle
