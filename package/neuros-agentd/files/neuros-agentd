#!/bin/sh
# NeurOS agent orchestrator (prototype).
#
# - runs the selected agent CLI inside a tmux session ("agent")
# - tees the pane output to the TTS filter and a status classifier
# - drives the compositor panes through neuros-ctl
#
# The centre-pane terminal shows this session via `tmux attach -t agent`.
set -u

CONF=/etc/neuros/agentd.conf
[ -r "$CONF" ] && . "$CONF"
: "${AGENT_NAME:=Agent}"
: "${AGENT_CMD:=/usr/lib/neuros/mock-agent}"
: "${AGENT_USER:=}"
: "${AGENT_WORKDIR:=/root}"
: "${TMUX_SESSION:=agent}"

RT="${XDG_RUNTIME_DIR:-/run/user/0}/neuros"
mkdir -p "$RT"
RAW="$RT/agent.raw"
TTS="$RT/tts.txt"
: > "$RAW"
: > "$TTS"

# shared dir the (unprivileged) agent user can also write to - the Claude Code
# Stop hook drops the reply text here for TTS
SHARE=/run/neuros
mkdir -p "$SHARE" && chmod 1777 "$SHARE"

log() { echo "[agentd] $*" >&2; }

# 1. create the agent session immediately - neuros-session is waiting on it
if ! tmux has-session -t "$TMUX_SESSION" 2>/dev/null; then
	# drop privileges to AGENT_USER when set and we're root; else run in place.
	# (AGENT_WORKDIR / AGENT_CMD are simple tokens - no spaces - so no quoting.)
	# COLORTERM makes Claude Code emit 24-bit colour (its mascot is orange, not
	# pink); su strips the env so it has to be set inside the -c string.
	if [ -n "$AGENT_USER" ] && [ "$(id -u)" = 0 ] && id "$AGENT_USER" >/dev/null 2>&1; then
		log "starting agent: $AGENT_CMD as $AGENT_USER (cwd $AGENT_WORKDIR)"
		AGENT_LAUNCH="su -s /bin/sh $AGENT_USER -c 'export COLORTERM=truecolor; cd $AGENT_WORKDIR && exec $AGENT_CMD'"
	else
		log "starting agent: $AGENT_CMD (cwd $AGENT_WORKDIR)"
		mkdir -p "$AGENT_WORKDIR"
		export COLORTERM=truecolor
		AGENT_LAUNCH="$AGENT_CMD"
	fi
	tmux new-session -d -s "$TMUX_SESSION" -x 220 -y 50 -c "$AGENT_WORKDIR" "$AGENT_LAUNCH"
	tmux set-option -t "$TMUX_SESSION" status off
fi

# 2. now wait (briefly) for the compositor control socket
i=0
while [ ! -S "${XDG_RUNTIME_DIR:-/run/user/0}/neuros-comp.sock" ] && [ $i -lt 100 ]; do
	sleep 0.2
	i=$((i + 1))
done

neuros-ctl agent "$AGENT_NAME" 2>/dev/null || true
neuros-ctl status Idle 2>/dev/null || true
[ -n "${AGENT_MODEL:-}" ] && neuros-ctl model "$AGENT_MODEL" 2>/dev/null || true

# tee the pane; -O = also capture existing scrollback
tmux pipe-pane -t "$TMUX_SESSION" -O "cat >> '$RAW'"

: "${TTS_VOICE:=/usr/share/piper-voices/default.onnx}"
[ -r "$TTS_VOICE" ] || TTS_VOICE=""
: "${TTS_MAXCHARS:=700}"

speak() {
	[ -n "$TTS_VOICE" ] || return 0
	command -v piper >/dev/null 2>&1 || return 0
	printf '%s' "$1" | cut -c"1-$TTS_MAXCHARS" |
		piper -q -m "$TTS_VOICE" --output-raw 2>/dev/null |
		aplay -q -r 22050 -f S16_LE -c 1 -t raw - 2>/dev/null
}

# The agent's reply text comes from the Claude Code Stop hook (neuros-agent-hook
# -> $RT/reply.txt), which reads the session transcript - far more reliable than
# scraping the redraw-heavy TUI. Fall back to nothing if the hook didn't fire.
# the Stop hook (running as the agent user) owns this file; we only read it
REPLY_FILE="$SHARE/reply.txt"
rm -f "$REPLY_FILE"

# (a) activity sub-line: watch the raw pipe for tool calls -> "using <tool>"
tail -n0 -F "$RAW" 2>/dev/null | while IFS= read -r line; do
	printf '%s\n' "$line" | /usr/lib/neuros/tts-filter >> "$TTS"
	case "$line" in
	*"Bash("*)   neuros-ctl activity "bash" 2>/dev/null || true ;;
	*"Edit("* | *"Update("* | *"Write("*) neuros-ctl activity "edit" 2>/dev/null || true ;;
	*"Read("*)   neuros-ctl activity "read" 2>/dev/null || true ;;
	*"Grep("* | *"Glob("* | *"Search("*) neuros-ctl activity "search" 2>/dev/null || true ;;
	*"WebFetch"* | *"WebSearch"*) neuros-ctl activity "the web" 2>/dev/null || true ;;
	esac
done &
WATCH=$!

# (b) status poller: classify the whole visible pane once a second; speak the
# reply on the busy -> Idle edge.
PREV=Idle
LASTSPEAK=""
while tmux has-session -t "$TMUX_SESSION" 2>/dev/null; do
	st=$(tmux capture-pane -t "$TMUX_SESSION" -p 2>/dev/null | /usr/lib/neuros/agent-status)
	: "${st:=Idle}"
	if [ "$st" != "$PREV" ]; then
		neuros-ctl status "$st" 2>/dev/null || true
		case "$st" in
		Idle | Waiting)
			neuros-ctl activity "" 2>/dev/null || true
			case "$PREV" in
			Working | Thinking)
				# the Stop hook may land a beat after the UI goes idle
				sleep 1
				msg=$(cat "$REPLY_FILE" 2>/dev/null)
				if [ -n "$msg" ] && [ "$msg" != "$LASTSPEAK" ]; then
					speak "$msg" &
					LASTSPEAK="$msg"
				fi
				;;
			esac
			;;
		esac
		PREV="$st"
	fi
	sleep 1
done
kill "$WATCH" 2>/dev/null
neuros-ctl status Idle 2>/dev/null || true
log "agent session ended"
