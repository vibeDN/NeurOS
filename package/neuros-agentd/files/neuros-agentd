#!/bin/sh
# NeurOS agent orchestrator (prototype).
#
# - runs the selected agent CLI inside a tmux session ("agent")
# - tees the pane output to the TTS filter and a status classifier
# - drives the compositor panes through neuros-ctl
#
# The centre-pane terminal shows this session via `tmux attach -t agent`.
set -u

CONF=/etc/neuros/agentd.conf
[ -r "$CONF" ] && . "$CONF"
: "${AGENT_NAME:=Agent}"
: "${AGENT_CMD:=/usr/lib/neuros/mock-agent}"
: "${TMUX_SESSION:=agent}"

RT="${XDG_RUNTIME_DIR:-/run/user/0}/neuros"
mkdir -p "$RT"
RAW="$RT/agent.raw"
TTS="$RT/tts.txt"
: > "$RAW"
: > "$TTS"

log() { echo "[agentd] $*" >&2; }

# 1. create the agent session immediately - neuros-session is waiting on it
if ! tmux has-session -t "$TMUX_SESSION" 2>/dev/null; then
	log "starting agent: $AGENT_CMD"
	tmux new-session -d -s "$TMUX_SESSION" -x 220 -y 50 "$AGENT_CMD"
	tmux set-option -t "$TMUX_SESSION" status off
fi

# 2. now wait (briefly) for the compositor control socket
i=0
while [ ! -S "${XDG_RUNTIME_DIR:-/run/user/0}/neuros-comp.sock" ] && [ $i -lt 100 ]; do
	sleep 0.2
	i=$((i + 1))
done

neuros-ctl agent "$AGENT_NAME" 2>/dev/null || true
neuros-ctl status Idle 2>/dev/null || true

# tee the pane; -O = also capture existing scrollback
tmux pipe-pane -t "$TMUX_SESSION" -O "cat >> '$RAW'"

: "${TTS_VOICE:=/usr/share/piper-voices/default.onnx}"
[ -r "$TTS_VOICE" ] || TTS_VOICE=""

speak() {
	[ -n "$TTS_VOICE" ] || return 0
	command -v piper >/dev/null 2>&1 || return 0
	printf '%s\n' "$1" | piper -q -m "$TTS_VOICE" --output-raw 2>/dev/null |
		aplay -q -r 22050 -f S16_LE -c 1 -t raw - 2>/dev/null
}

# process the stream: TTS filter + status classification + speech
tail -n0 -F "$RAW" 2>/dev/null | while IFS= read -r line; do
	clean=$(printf '%s\n' "$line" | /usr/lib/neuros/tts-filter)
	printf '%s\n' "$clean" >> "$TTS"

	# only speak prose: has a lowercase letter, reasonably long, not a prompt/TUI line
	case "$clean" in
	*[a-z]*)
		if [ "${#clean}" -ge 12 ] && \
		   [ "${clean#*"? for shortcuts"}" = "$clean" ] && \
		   [ "${clean#>}" = "$clean" ]; then
			speak "$clean" &
		fi
		;;
	esac

	st=$(printf '%s\n' "$line" | /usr/lib/neuros/agent-status)
	[ -n "$st" ] && neuros-ctl status "$st" 2>/dev/null || true
done &
WATCH=$!

# exit with the agent session
while tmux has-session -t "$TMUX_SESSION" 2>/dev/null; do
	sleep 2
done
kill "$WATCH" 2>/dev/null
neuros-ctl status Idle 2>/dev/null || true
log "agent session ended"
